# Cloudflare aplica estas cabeceras a los archivos estáticos.
# Revisar Permissions-Policy cada vez que una feature nueva use una API del
# navegador: <input capture> (subir foto de apuntes) no necesita permiso;
# getUserMedia sí, y aquí no se usa.

/sw.js
  Cache-Control: no-cache

/shell.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), midi=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
